# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.

# ── LLM (lyric writer) ──────────────────────────────────────────
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

# ── ACE-Step music backend (bring your own) ─────────────────────
# Default: point at an already-running ACE-Step API. See ACE_STEP_API.md.
ACE_STEP_ENDPOINT=http://127.0.0.1:8001
ACE_STEP_LM=acestep-5Hz-lm-1.7B
ACE_STEP_POLL_SECONDS=8
ACE_STEP_POLL_MAX=120
# Advanced: let SongForge spawn ACE-Step locally (needs the two paths below).
ACE_STEP_SPAWN_LOCAL=false
#ACE_STEP_DIR=/path/to/ACE-Step
#ACE_STEP_UV=/path/to/uv

# ── Media ───────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
# Caption fonts. OFL fonts recommended (e.g. Noto Sans / Noto Serif).
# Omit to fall back to a system font.
#FONT_REGULAR=/path/to/Regular.ttf
#FONT_BOLD=/path/to/Bold.ttf
# Optional background video. Pexels License (NOT CC0): no reselling unaltered
# copies, identifiable-people/property limits. Omit to use solid/gradient bg.
#PEXELS_API_KEY=

# ── Output ──────────────────────────────────────────────────────
#SONGFORGE_OUT_DIR=./out
