{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://songforge/schemas/song_spec.schema.json",
  "title": "SongForge song spec",
  "description": "Contract for the lyric-writer output. Enforced in lyrics.validate_spec().",
  "type": "object",
  "required": ["slug", "title", "theme", "full_lyrics", "hook", "tags"],
  "additionalProperties": true,
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9_]{3,40}$",
      "description": "ascii snake_case identifier; output folder name"
    },
    "title": { "type": "string", "minLength": 1 },
    "theme": { "type": "string", "minLength": 1, "description": "one-line theme summary" },
    "full_lyrics": {
      "type": "string",
      "pattern": "\\[chorus\\]",
      "description": "section-tagged lyrics; must contain at least one [chorus]"
    },
    "hook": { "type": "string", "minLength": 1, "description": "chorus hook, max ~2 lines" },
    "bg_query": { "type": "string", "description": "optional background-video search terms" },
    "description": { "type": "string", "description": "optional upload description sentence" },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
